# Copy to .env and adjust. Nested keys use the `__` delimiter.
RESEARCHAGENT_ENVIRONMENT=local
RESEARCHAGENT_DEBUG=false
RESEARCHAGENT_LOG_LEVEL=INFO
RESEARCHAGENT_LOG_FORMAT=console

RESEARCHAGENT_API_HOST=0.0.0.0
RESEARCHAGENT_API_PORT=8000

RESEARCHAGENT_OLLAMA__BASE_URL=http://localhost:11434
RESEARCHAGENT_OLLAMA__REQUEST_TIMEOUT_SECONDS=300
RESEARCHAGENT_OLLAMA__KEEP_ALIVE=10m

RESEARCHAGENT_POSTGRES__HOST=localhost
RESEARCHAGENT_POSTGRES__PORT=5432
RESEARCHAGENT_POSTGRES__USER=researchagent
RESEARCHAGENT_POSTGRES__PASSWORD=researchagent
RESEARCHAGENT_POSTGRES__DATABASE=researchagent

RESEARCHAGENT_QDRANT__HOST=localhost
RESEARCHAGENT_QDRANT__PORT=6333

RESEARCHAGENT_NEO4J__URI=bolt://localhost:7687
RESEARCHAGENT_NEO4J__USER=neo4j
RESEARCHAGENT_NEO4J__PASSWORD=researchagent
